# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Core
#
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
/wp-content/index.php
/wp-content/languages
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-content/themes/thelocalny/acf-json/*
/license.txt
/readme.html
/xmlrpc.php

# Configuration
wp-config.php

# Composer dev dependencies (installed in CI for PHPCS/SonarQube)
/vendor/
# PHPCS + SonarQube generated reports (regenerated on every CI run)
/reports/
# Python bytecode from the PR-decoration / checkstyle conversion scripts
__pycache__/
*.pyc

# ignore node dependency directories
/node_modules/
/wp-content/themes/intech/node_modules/
/db/
/document/
# Example themes
/wp-content/themes/twenty*/

# Example plugin
/wp-content/plugins/hello.php

# Uploads
/wp-content/uploads/

# Log files
*.log

# htaccess
/.htaccess

# All plugins
#
# Note: If you wish to whitelist plugins,
# uncomment the next line
#/wp-content/plugins
#/wp-content/plugins/nextbricks/
wp-content/plugins/*/.git/
# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
#/wp-content/themes


# ignore log files and databases
*.log
*.sqlite
*.zip
*.sql
*.patch
# ignore files
.htaccess
robots.txt

# Packages #
############
*.7z
*.dmg
*.gz
*.bz2
*.iso
*.jar
*.rar
*.tar
*.zip
*.tgz
*.patch

# Logs and databases #
######################
*.log
*.sql

# OS generated files #
######################
.DS_Store*
ehthumbs.db